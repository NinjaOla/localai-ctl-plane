@page "/models"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IAsyncDisposable
@inject IAgentModelGateway AgentModels
@inject HuggingFaceClient HuggingFace
@inject DownloadProgressStore Downloads
@inject ListNodes.Handler ListNodesHandler
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ILogger<Models> Logger

<PageTitle>Models | llamactl</PageTitle>
<div class="page-heading"><div><p class="eyebrow">Model management</p><h1>Models</h1></div><MudSelect T="Guid" Value="@_nodeId" ValueChanged="NodeChanged" Label="Node" Variant="Variant.Outlined" Dense="true" Class="node-picker">@foreach (var node in _nodes) { <MudSelectItem T="Guid" Value="@node.Id">@node.Name</MudSelectItem> }</MudSelect></div>

@if (_error is not null) { <div class="inline-error">@_error</div> }

<section class="operator-panel model-section">
    <div class="section-heading"><div><h2>Node inventory</h2><p>GGUF files under the configured models root and unreferenced HF blobs.</p></div><div class="form-actions"><MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadInventoryAsync">Scan</MudButton><MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AccountTree" OnClick="@(() => ReconcileAsync(true))">Preview library</MudButton></div></div>
    @if (_inventory is null) { <div class="empty-state"><strong>No inventory loaded</strong><span>Select a connected node and scan its model storage.</span></div> }
    else
    {
        <div class="model-summary"><span><strong>@_inventory.Files.Count</strong> GGUF files</span><span><strong>@FormatBytes(_inventory.Files.Sum(file => file.SizeBytes))</strong> catalogued</span><span><strong>@FormatBytes(_inventory.FreeBytes)</strong> free</span><span><strong>@_inventory.OrphanedBlobs.Count</strong> orphan blobs</span></div>
        <MudTable Items="_inventory.Files" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm">
            <HeaderContent><MudTh>Path</MudTh><MudTh>Size</MudTh><MudTh>Traits</MudTh><MudTh></MudTh></HeaderContent>
            <RowTemplate><MudTd DataLabel="Path"><strong>@context.RelativePath</strong></MudTd><MudTd DataLabel="Size">@FormatBytes(context.SizeBytes)</MudTd><MudTd DataLabel="Traits">@Traits(context)</MudTd><MudTd DataLabel="Actions"><MudTooltip Text="Inspect GGUF"><MudIconButton Icon="@Icons.Material.Filled.Info" aria-label="Inspect GGUF" OnClick="@(() => InspectAsync(context))" /></MudTooltip><MudTooltip Text="Delete model"><MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="Delete model" Color="Color.Error" OnClick="@(() => DeleteAsync([context.RelativePath], context.FromHfCache))" /></MudTooltip></MudTd></RowTemplate>
        </MudTable>
        @if (_inventory.OrphanedBlobs.Count > 0)
        {
            <div class="orphan-list"><h3>Orphaned blobs</h3>@foreach (var blob in _inventory.OrphanedBlobs) { <div><span>@blob.RelativePath</span><span>@FormatBytes(blob.SizeBytes)</span><MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="Delete orphan blob" Color="Color.Error" OnClick="@(() => DeleteAsync([blob.RelativePath], true))" /></div> }</div>
        }
    }
</section>

@if (_reconcile is not null)
{
    <section class="operator-panel model-section"><div class="section-heading"><div><h2>Library reconciliation</h2><p>@_reconcile.Operations.Count planned filesystem operations.</p></div></div><pre class="operation-list">@string.Join(Environment.NewLine, _reconcile.Operations.Select(OperationText))</pre><MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="@_reconcile.Applied" OnClick="@(() => ReconcileAsync(false))">Apply operations</MudButton></section>
}

@if (_inspection is not null)
{
    <section class="operator-panel model-section"><div class="section-heading"><div><h2>GGUF inspection</h2><p>@_inspection.RelativePath</p></div></div><div class="inspection-grid"><span>Architecture<strong>@(_inspection.Architecture ?? "Unknown")</strong></span><span>Training context<strong>@(_inspection.TrainingContext?.ToString("N0") ?? "Unknown")</strong></span><span>Tensors<strong>@_inspection.TensorCount</strong></span><span>Draft head<strong>@(_inspection.HasDraftHead ? "Detected" : "Not detected")</strong></span></div>@if (_inspection.HasDraftHead) { <div class="router-warning"><strong>MTP/draft tensors detected</strong><span>Consider enabling <code>spec-type = draft-mtp</code> in the model preset.</span></div> }</section>
}

<section class="operator-panel model-section">
    <div class="section-heading"><div><h2>Hugging Face</h2><p>Search GGUF repositories, compare fit, and download selected files to this node.</p></div></div>
    <div class="search-row"><MudTextField T="string" @bind-Value="_query" Label="Repository or model" Variant="Variant.Outlined" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" /><MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SearchAsync">Search</MudButton></div>
    @if (_repositories.Count > 0) { <MudTable Items="_repositories" Dense="true" Hover="true" Elevation="0"><HeaderContent><MudTh>Repository</MudTh><MudTh>Downloads</MudTh><MudTh>Likes</MudTh></HeaderContent><RowTemplate><MudTd><MudButton Variant="Variant.Text" OnClick="@(() => SelectRepositoryAsync(context))">@context.Id</MudButton></MudTd><MudTd>@context.Downloads.ToString("N0")</MudTd><MudTd>@context.Likes.ToString("N0")</MudTd></RowTemplate></MudTable> }
    @if (_repository is not null)
    {
        <h3>@_repository.Id</h3>
        <div class="hf-files">@foreach (var file in _hfFiles) { <label><MudCheckBox T="bool" Value="@_selected.Contains(file.Path)" ValueChanged="@(selected => SelectFile(file.Path, selected))" Color="Color.Success" /><span>@file.Path</span><span>@FormatBytes(file.SizeBytes)</span></label> }</div>
        @if (_estimates.Count > 0) { <div class="fit-grid">@foreach (var estimate in _estimates) { <div class="fit-@estimate.Verdict.ToString().ToLowerInvariant()"><strong>@estimate.Variant</strong><span>@FormatBytes(estimate.SizeBytes)</span><span>@estimate.Verdict</span><small>@estimate.Caveat</small></div> }</div> }
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Download" Disabled="@(!_selected.Any())" OnClick="StartDownloadAsync">Download selected</MudButton>
    }
</section>

@if (_progress.Count > 0)
{
    <section class="operator-panel model-section"><div class="section-heading"><div><h2>Downloads</h2><p>Agent-owned transfers continue when this page closes.</p></div></div>@foreach (var item in _progress) { <div class="download-row"><div><strong>@item.Id</strong><span>@item.CurrentFile</span></div><MudProgressLinear Value="@Progress(item)" Color="Color.Success" /><span>@item.State · @FormatBytes(item.BytesReceived) / @FormatBytes(item.TotalBytes)</span>@if (item.State is DownloadState.Running or DownloadState.Queued) { <MudIconButton Icon="@Icons.Material.Filled.Cancel" aria-label="Cancel download" Color="Color.Error" OnClick="@(() => CancelAsync(item.Id))" /> }</div> }</section>
}

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private IReadOnlyList<ListNodes.Response> _nodes = [];
    private IReadOnlyList<HuggingFaceRepository> _repositories = [];
    private IReadOnlyList<HuggingFaceFile> _hfFiles = [];
    private IReadOnlyList<ModelFitEstimate> _estimates = [];
    private IReadOnlyList<DownloadProgress> _progress = [];
    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    private Guid _nodeId;
    private string _query = string.Empty;
    private string? _error;
    private ModelInventory? _inventory;
    private ReconcileLibraryResult? _reconcile;
    private GgufInspection? _inspection;
    private HuggingFaceRepository? _repository;
    private Task? _pollTask;

    protected override async Task OnInitializedAsync() { _nodes = await ListNodesHandler.HandleAsync(new(), _lifetime.Token); _nodeId = _nodes.FirstOrDefault()?.Id ?? Guid.Empty; _pollTask = PollProgressAsync(); if (_nodeId != Guid.Empty) await LoadInventoryAsync(); }
    private async Task NodeChanged(Guid nodeId) { _nodeId = nodeId; _inventory = null; _inspection = null; _reconcile = null; await LoadInventoryAsync(); }
    private async Task LoadInventoryAsync() { _error = null; _inventory = await TryAsync(() => AgentModels.ScanAsync(_nodeId, _lifetime.Token)); if (_inventory is null && _error is null) _error = "Node is not connected."; RecalculateFit(); }
    private async Task ReconcileAsync(bool dryRun) { _reconcile = await TryAsync(() => AgentModels.ReconcileAsync(_nodeId, dryRun, _lifetime.Token)); if (_reconcile is null && _error is null) _error = "Node is not connected."; else if (_reconcile is not null && !dryRun) { Snackbar.Add("Flat model library reconciled.", Severity.Success); await LoadInventoryAsync(); } }
    private async Task InspectAsync(ModelFile file) { _inspection = await TryAsync(() => AgentModels.InspectAsync(_nodeId, new(file.RelativePath, file.FromHfCache), _lifetime.Token)); if (_inspection is null && _error is null) _error = "Node is not connected."; }
    private async Task DeleteAsync(IReadOnlyList<string> paths, bool fromHfCache = false) { if (!await JS.InvokeAsync<bool>("confirm", $"Delete {paths.Count} selected file(s)?")) return; var result = await TryAsync(() => AgentModels.DeleteAsync(_nodeId, new(paths, fromHfCache), _lifetime.Token)); if (result is null) { if (_error is null) _error = "Node is not connected."; return; } Snackbar.Add($"Freed {FormatBytes(result.FreedBytes)}.", Severity.Success); await LoadInventoryAsync(); }
    private async Task SearchAsync() { if (string.IsNullOrWhiteSpace(_query)) return; _repositories = await TryAsync(() => HuggingFace.SearchAsync(_query, _lifetime.Token)) ?? []; }
    private async Task SelectRepositoryAsync(HuggingFaceRepository repository) { _repository = repository; _selected.Clear(); _hfFiles = await TryAsync(() => HuggingFace.FilesAsync(repository.Id, _lifetime.Token)) ?? []; RecalculateFit(); }
    private void SelectFile(string path, bool selected) { var chosen = _hfFiles.Single(file => file.Path == path); var variant = ModelFitCalculator.Variant(chosen); foreach (var file in _hfFiles.Where(file => ModelFitCalculator.Variant(file) == variant)) { if (selected) _selected.Add(file.Path); else _selected.Remove(file.Path); } RecalculateFit(); }
    private void RecalculateFit() { var files = _hfFiles.Where(file => _selected.Contains(file.Path)).ToList(); _estimates = files.Count == 0 ? [] : ModelFitCalculator.Estimate(files, _nodes.SingleOrDefault(node => node.Id == _nodeId)?.VramTotalMiB ?? 0, _inventory?.FreeBytes ?? 0); }
    private async Task StartDownloadAsync() { if (_repository is null) return; var files = _hfFiles.Where(file => _selected.Contains(file.Path)).ToList(); var id = await TryAsync(() => AgentModels.StartDownloadAsync(_nodeId, new(_repository.Id, "main", files), _lifetime.Token)); if (id is null && _error is null) _error = "Node is not connected."; else if (id is not null) Snackbar.Add($"Download {id} started.", Severity.Success); }
    private async Task CancelAsync(Guid id) { _ = await TryAsync(() => AgentModels.CancelDownloadAsync(_nodeId, id, _lifetime.Token)); }
    private async Task PollProgressAsync() { using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1)); try { while (await timer.WaitForNextTickAsync(_lifetime.Token)) { _progress = Downloads.Read(_nodeId); await InvokeAsync(StateHasChanged); } } catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { return; } }
    private static double Progress(DownloadProgress item) => item.TotalBytes <= 0 ? 0 : item.BytesReceived * 100d / item.TotalBytes;
    private static string FormatBytes(long value) { string[] units = ["B", "KiB", "MiB", "GiB", "TiB"]; var size = (double)value; var unit = 0; while (size >= 1024 && unit < units.Length - 1) { size /= 1024; unit++; } return $"{size:0.#} {units[unit]}"; }
    private static string Traits(ModelFile file) => string.Join(", ", new[] { file.IsShard ? "shard" : null, file.IsMmproj ? "mmproj" : null, file.IsDraftHead ? "draft" : null }.OfType<string>().DefaultIfEmpty("model"));
    private static string OperationText(LibraryOperation operation) => operation.Target is null ? $"{operation.Kind}: {operation.Path}" : $"{operation.Kind}: {operation.Path} -> {operation.Target}";
    private async Task<T?> TryAsync<T>(Func<Task<T>> operation) { try { _error = null; return await operation(); } catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { throw; } catch (Exception exception) { Logger.LogError(exception, "Model operation failed"); _error = "The model operation failed. Check the node connection and try again."; return default; } }
    public async ValueTask DisposeAsync() { _lifetime.Cancel(); if (_pollTask is not null) await _pollTask; _lifetime.Dispose(); }
}